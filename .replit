
run = "npm start"
entrypoint = "server.js"
modules = ["nodejs-20", "postgresql-16"]

[nix]
channel = "stable-23_11"

[deployment]
run = ["node", "server.js"]
deploymentTarget = "autoscale"
build = ["npm", "install"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
